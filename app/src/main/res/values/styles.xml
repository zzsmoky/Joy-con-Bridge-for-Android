<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JoyCon2Bridge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">sans</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="materialCardViewStyle">@style/Widget.JoyConBridge.Card</item>
        <item name="materialButtonStyle">@style/Widget.JoyConBridge.Button</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
    </style>

    <style name="Widget.JoyConBridge.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.JoyConBridge.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.JoyConBridge.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
    </style>
    <style name="NotificationAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:background">@drawable/notification_action_background</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">#DDF5FF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NotificationStopAction" parent="NotificationAction">
        <item name="android:textColor">#FFB4AB</item>
    </style>
</resources>
